; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Tower"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

WorldFlags="*res://scripts/core/world_flags.gd"
GameClock="*res://scripts/core/game_clock.gd"
LawSystem="*res://scripts/core/law_system.gd"
ScenarioManager="*res://scripts/scenario/scenario_manager.gd"
Society="*res://scripts/society/society.gd"
SaveSystem="*res://scripts/core/save_system.gd"

[dotnet]

project/assembly_name="The Tower"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
